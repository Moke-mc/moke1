/* pages/parent/comments/comments.wxss */
.student-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.student-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}
.student-tab.active {
  background: #10b981;
  color: #fff;
}
.comment-box {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}
.comment-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}
