/* pages/parent/schedule/schedule.wxss */
.student-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.student-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.student-tab.active {
  background: #10b981;
  color: #fff;
}

.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.filter {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 8rpx;
}

.filter.active {
  background: #d1fae5;
  color: #065f46;
  font-weight: 600;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}
