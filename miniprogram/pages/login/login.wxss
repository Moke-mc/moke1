/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #10b981 0%, #047857 100%);
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 70rpx;
  font-weight: 600;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
}

.logo-title {
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.logo-sub {
  color: rgba(255,255,255,0.8);
  font-size: 26rpx;
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #9ca3af;
  font-size: 30rpx;
  position: relative;
}

.tab.active {
  color: #10b981;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -2rpx;
  width: 60rpx;
  height: 4rpx;
  background: #10b981;
  transform: translateX(-50%);
  border-radius: 4rpx;
}

.wx-login, .pwd-login {
  text-align: center;
}

.wx-tip {
  color: #6b7280;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.wx-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
  text-align: left;
}

.form-item .label {
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

.switch-tip {
  color: #10b981;
  font-size: 26rpx;
  margin-top: 24rpx;
}

.demo-tip {
  margin-top: 60rpx;
  text-align: center;
  line-height: 1.8;
}
