/* pages/admin/schedules/schedules.wxss */
.add-btn { padding: 12rpx 32rpx; font-size: 26rpx; }
.status {
  padding: 6rpx 16rpx; border-radius: 16rpx; font-size: 22rpx;
  background: #d1fae5; color: #065f46;
}
.status.done { background: #e5e7eb; color: #4b5563; }
.actions { display: flex; gap: 16rpx; justify-content: flex-end; }
.action-btn { padding: 8rpx 24rpx; font-size: 24rpx; }
.action-btn.danger { color: #ef4444; border-color: #ef4444; }
.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 99;
  display: flex; align-items: flex-end;
}
.modal {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx; max-height: 85vh; overflow-y: auto;
}
.modal-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.form-item { margin-bottom: 24rpx; }
.form-item .label { font-size: 26rpx; color: #374151; margin-bottom: 12rpx; }
.picker { line-height: 1.6; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-actions button { flex: 1; }
