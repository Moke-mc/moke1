/* pages/admin/students/students.wxss */
.add-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}
.student-item .avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
}
.avatar-default {
  background: #6366f1;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
}
.ml { margin-left: 24rpx; }
.actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.action-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}
.action-btn.danger {
  color: #ef4444;
  border-color: #ef4444;
}

.modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}
.form-scroll {
  max-height: 60vh;
}
.section-divider {
  margin: 24rpx 0;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-top: 2rpx solid #f3f4f6;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.modal-actions button {
  flex: 1;
}
