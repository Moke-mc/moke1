/* pages/admin/index/index.wxss */
.header {
  background: linear-gradient(135deg, #6366f1, #4338ca);
  padding: 40rpx 32rpx 60rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin: -24rpx -24rpx 24rpx;
}
.logout {
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.stat-card {
  flex: 1 1 calc(50% - 16rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.stat-card.full {
  flex: 1 1 100%;
}
.num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1f2937;
}
.menu {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}
.arrow {
  color: #d1d5db;
  font-size: 40rpx;
}
