/* pages/teacher/schedule/schedule.wxss */
.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.filter {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 8rpx;
}
.filter.active {
  background: #dbeafe;
  color: #1d4ed8;
  font-weight: 600;
}
.status {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: #d1fae5;
  color: #065f46;
}
.status.done {
  background: #e5e7eb;
  color: #4b5563;
}
