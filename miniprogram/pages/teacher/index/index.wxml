<!--pages/teacher/index/index.wxml-->
<view class="container">
  <view class="header">
    <view class="flex items-center justify-between">
      <view>
        <view class="text-lg text-gray-light">你好，{{user.name}}</view>
        <view class="text-sm text-gray-light">教师端</view>
      </view>
      <view class="logout" bindtap="logout">退出</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="num">{{stats.total}}</view>
      <view class="text-sm text-gray">今日课程</view>
    </view>
    <view class="stat-item">
      <view class="num text-green">{{stats.completed}}</view>
      <view class="text-sm text-gray">已完成</view>
    </view>
    <view class="stat-item">
      <view class="num text-orange">{{stats.pending}}</view>
      <view class="text-sm text-gray">待上课</view>
    </view>
  </view>

  <view class="page-title">今日课程</view>
  <view wx:if="{{todaySchedules.length === 0 && !loading}}" class="card empty">今日暂无课程</view>
  <view class="card" wx:for="{{todaySchedules}}" wx:key="id">
    <view class="flex items-center justify-between">
      <view class="flex-1">
        <view class="font-bold text-md">{{item.student_name}} - {{item.course_name}}</view>
        <view class="text-sm text-gray mt-sm">⏰ {{item.time}}</view>
      </view>
      <view class="status-tag {{item.status === 'completed' ? 'tag-gray' : 'tag'}}">
        {{item.status === 'completed' ? '已签到' : '待签到'}}
      </view>
    </view>
  </view>

  <view class="page-title mt">快捷入口</view>
  <view class="card quick-entries">
    <view class="quick-item" bindtap="goStudents">
      <view class="quick-icon" style="background:#dbeafe">👥</view>
      <view class="text-sm">授课学员</view>
    </view>
    <view class="quick-item" bindtap="goCheckin">
      <view class="quick-icon" style="background:#d1fae5">✅</view>
      <view class="text-sm">课时签到</view>
    </view>
    <view class="quick-item" bindtap="goSchedule">
      <view class="quick-icon" style="background:#fef3c7">📅</view>
      <view class="text-sm">我的课表</view>
    </view>
  </view>
</view>
